# 教学示例预设：DeepSeek 官方兼容接口。选择其他平台时同时修改地址、模型名和密钥。
# 复制为工作区根目录 .env 后在本机填入密钥；此文件不含真实凭证。
COMPATIBLE_BASE_URL=https://api.deepseek.com
COMPATIBLE_MODEL=deepseek-flash
COMPATIBLE_API_KEY=

# QQ邮箱可选配置：在本机运行configure_mail.py；授权码不发送到聊天或写入版本库。
# 留空时保持未启用；轮询间隔与首次收取数量使用代码默认值。
QQ_MAIL_ENABLED=
QQ_MAIL_ACCOUNT=
QQ_MAIL_AUTH_CODE=
QQ_MAIL_POLL_SECONDS=
QQ_MAIL_INITIAL_LIMIT=
